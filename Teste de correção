int localizacliente(struct clientes cliente[], int qtdclientes)
{
    int valor = 0, encontrado = 0;
    
    printf("Digite o código do cliente: ");
    scanf("%d", &valor);
    
    for(int i = 0;  i < qtdclientes; i++)
    {
        if(cliente[i].codigo == valor)
