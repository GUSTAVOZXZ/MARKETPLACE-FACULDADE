struct carrinhos finalizarvenda(struct carrinhos carrinho)
{
    char escolha;
    
    printf("Deseja efetuar a compra(S  = Sim / N = Não)");
    scanf(" %c", &escolha);
    
    if(escolha == 'S' || escolha == 's')
    {
        printf("Agradecemos pela preferência, Volte Sempre!\n");
    }
}
struct carrinhos efetuarvenda(struct clientes cliente[], int qtdclientes, struct produtos produto[], int qtdprodutos, struct carrinhos carrinho, int TAM_CARRINHO)
{
    int idxcliente, i;
    int qtdcarrinho = 0;
    
    listarclientes(cliente, qtdclientes);
        
    idxcliente = localizacliente(cliente, qtdclientes);
    
    if(idxcliente < 0)
    {
        printf("\nCliente não encontrado, cancelando a venda.\n");
        return carrinho;
    }
    
    carrinho.cliente = cliente[idxcliente];
    
    listarprodutos(produto, qtdprodutos);
            
    carrinho = localizaproduto(produto, qtdprodutos, carrinho, TAM_CARRINHO);
    
    carrinho = calculasubtotal(carrinho);
    carrinho = calculatotal(carrinho);
    
    for(i = 0; i < TAM_CARRINHO; i++)
    {
        if(carrinho.produto[i].codigo != 0)
        {
            qtdcarrinho++;
        }
    }
    
    listarcarrinho(carrinho);
    finalizarvenda(carrinho);
    printf("\n");
    
    return carrinho;
}
