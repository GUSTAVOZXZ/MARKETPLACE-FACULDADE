/*Função para localizar o cliente cadastrado e salvar no carrinho*/

int localizacliente(struct clientes cliente[], int qtdclientes)
{
    int valor = 0, encontrado = 0;
    
    if(qtdclientes == 0)
    {
        return -1; /*Laço de retorno para sair ao verificar que não há cliente cadastrado*/
    }
    
    printf("Digite o código do cliente: ");
    scanf("%d", &valor);
    
    for(int i = 0;  i < qtdclientes; i++)
    {
        if(cliente[i].codigo == valor)
        {
            encontrado = 1;
            printf("\n|cliente Encontrado|\n");
            printf("Código: %d\n", cliente[i].codigo);
            printf("Nome: %s\n", cliente[i].nome);
            printf("CPF: %.0lf\n", cliente[i].cpf);
            printf("Sexo: %c\n", cliente[i].sexo);
            printf("Telefone Fixo: %s\n", cliente[i].tel.fixo);
            printf("Telefone movel: %s\n\n", cliente[i].tel.movel);
            
            return i;
        }
    }

    return -1; /*Laço de retorno para sair da localização ao não encontrar clientes*/
}

/*Função para localizar os produtos e salvar no carrinho*/

struct carrinhos localizaproduto(struct produtos produto[], int qtdprodutos, struct carrinhos carrinho, int TAM_CARRINHO)
{
    int valor = 0, continuar;
    int encontrado, qtdcarrinho = 0;
    
    if(qtdprodutos == 0)
    {
        printf("\nNenhum Produto Cadastrado!\n");
        return carrinho; /*Laço de retorno para sair da localização quando não há produto cadastrado*/
    }
    
    do{
        encontrado = 0;
        
        printf("Digite o código do produto: ");
        scanf("%d", &valor);
        
        for(int i = 0;  i < qtdprodutos; i++)
        {
            if(produto[i].codigo == valor)
            {
                encontrado = 1;
                printf("\n|Produto Encontrado|\n");
                printf("Código: %d\n", produto[i].codigo);
                printf("Nome: %s\n", produto[i].nome);
                printf("Marca: %s\n", produto[i].modelo.marca);
                printf("Modelo: %s\n", produto[i].modelo.modelo);
                printf("Valor: %.2lf\n", produto[i].valor);
                carrinho.produto[qtdcarrinho] = produto[i]; /*Função recebe o valor do produto localizado*/
                printf("\nQual a quantidade desse produto você deseja: ");
                scanf("%d", &carrinho.quantidade[qtdcarrinho]);
                qtdcarrinho++; /*Variavel que salva o produto localizado a cada passagem da função*/
                break;
            }
        }
        
        if(!encontrado)
        {
            printf("\nProduto não encontrado!\n");
        }
        if(qtdcarrinho < TAM_CARRINHO)
        {
            printf("\nDeseja solicitar outro produto (1 = Sim / 0 = Não): ");
            scanf("%d", &continuar);
        }else{
            printf("\nLimite de produtos atingidos!\n");
            continuar = 0;
        }
        
    }while(continuar == 1 && qtdcarrinho < TAM_CARRINHO);
    
    return carrinho; /*Laço de retorno para voltar os valores na estrutura carrinho*/
}


/*Função para calcular o SubTotal da compra de todos os produtos*/
struct carrinhos calculasubtotal(struct carrinhos carrinho)
{
    carrinho.subtotal = 0;
    
    for (int i = 0; i < 3; i++)
    {
        if(carrinho.produto[i].codigo != 0)
        carrinho.subtotal = carrinho.subtotal + (carrinho.produto[i].valor*carrinho.quantidade[i]);
    }
    
    return carrinho; /*Laço de retorno para voltar os valores na estrutura carrinho*/
}

/*Função para calcular o total da compra após o desconto aplicado em SubTotal*/

struct carrinhos calculatotal(struct carrinhos carrinho)
{
    carrinho.desconto = 0;
    char validar;
    
    printf("\nAlgum desconto será aplicado na compra(S OU N)?");
    scanf(" %c", &validar);
    
    if(validar == 'S' || validar == 's')
    {
        printf("\nQual o desconto a ser aplicado(em %): ");
        scanf("%lf", &carrinho.desconto);
        
        carrinho.total = carrinho.subtotal * (1 - carrinho.desconto / 100);
        
    }else{
        carrinho.total = carrinho.subtotal;
    }
    
    return carrinho; /*Laço de retorno para voltar os valores na estrutura carrinho*/
}

/*Função para listar o carrinho com o cliente e os produtos salvos*/

void listarcarrinho(struct carrinhos carrinho)
{
    printf("\n||Cliente||\n");
    printf("Nome: %s\n", carrinho.cliente.nome);
    printf("Sexo: %c\n", carrinho.cliente.sexo);
    printf("CPF: %.0lf\n", carrinho.cliente.cpf);
    printf("Telefone fixo: %s\n", carrinho.cliente.tel.fixo);
    printf("Telefone Móvel: %s\n", carrinho.cliente.tel.movel);
    
    printf("\n| Código |       Nome       |   Marca    |   Modelo   |   Valor    | Quant. |\n");
    printf("----------------------------------------------------------------------------------\n");
    
    for (int i = 0; i < 3; i++)
    {
        if (carrinho.produto[i].codigo != 0)
        {
            printf("| %-6d | %-16s | %-10s | %-10s | R$ %-8.2lf | %-6d |\n",
                   carrinho.produto[i].codigo,      
                   carrinho.produto[i].nome,        
                   carrinho.produto[i].modelo.marca,
                   carrinho.produto[i].modelo.modelo,
                   carrinho.produto[i].valor,       
                   carrinho.quantidade[i]);     
            printf("----------------------------------------------------------------------------------\n");
        }
    }
    
    printf("Subtotal da compra: R$ %.2lf\n", carrinho.subtotal); 
    printf("Desconto: %.0lf%%\n", carrinho.desconto);
    printf("Valor Total: R$ %.2lf\n", carrinho.total); 
}

/*Função para validar a conclusão da venda com o cliente*/

struct carrinhos finalizarvenda(struct carrinhos carrinho)
{
    char escolha;
    
    printf("\nDeseja efetuar a compra(S  = Sim / N = Não)");
    scanf(" %c", &escolha);
    
    if(escolha == 'S' || escolha == 's')
    {
        printf("\nAgradecemos pela preferência, Volte Sempre!\n");
    }else{
        printf("\nCompra cancelada!\n");
    }
    
    return carrinho;/*Laço de retorno para voltar ao menu após a validação*/
}

/*Função para trazer todas as informações para listagem de cliente, produtos e efetuar a venda com o cliente*/

struct carrinhos efetuarvenda(struct clientes cliente[], int qtdclientes, struct produtos produto[], int qtdprodutos, struct carrinhos carrinho, int TAM_CARRINHO)
{
    int idxcliente, i;
    int qtdcarrinho = 0;
    
    listarclientes(cliente, qtdclientes);
        
    idxcliente = localizacliente(cliente, qtdclientes); /*Variavel que recebe o valor localizado pela função e apresentação na tela*/
    
   if(idxcliente < 0) /*Caso não encontrar o cliente pelo código*/
    {
        printf("\nCliente não encontrado, cancelando a venda.\n");
        return carrinho; /*Após verificar que o código não corresponde aos clientes, retorna ao final do código gerando o menu inicial*/
    }
    
    carrinho.cliente = cliente[idxcliente]; /*Função carrinho recebendo o valor da variável que localizou o cliente*/
    
    listarprodutos(produto, qtdprodutos); /*Listar todos os produtos cadastrados no código*/
            
    carrinho = localizaproduto(produto, qtdprodutos, carrinho, TAM_CARRINHO); /*Estrutura carrinho guarda o valor do produto localizado e apresenta no Display*/
    
    carrinho = calculasubtotal(carrinho); /*Estutura carrinho guarda o valor de subtotal após os produtos localizados*/
    carrinho = calculatotal(carrinho); /*Estrutura carrinho guarda o valor total após o calculo de subtotal dos produtos localizados*/
    
    for(i = 0; i < TAM_CARRINHO; i++)
    {
        if(carrinho.produto[i].codigo != 0)
        {
            qtdcarrinho++; /*Estrutura que define o tamanho do carrinho, verifica se o código do produto é valido e salva na variavel*/
        }
    }
    
    listarcarrinho(carrinho); /*Lista todas as informações após executar o código*/
    finalizarvenda(carrinho); /*Valida com o usuário a efetividade da venda*/
    printf("\n");
    
    return carrinho; /*Retorna para o menu inicial*/
}
