struct carrinhos localizaproduto(struct produtos produto[], int qtdprodutos, struct carrinhos carrinho, int TAM_CARRINHO)
{
    int valor = 0, continuar;
    int encontrado, qtdcarrinho = 0;
    
    if(qtdprodutos == 0)
    {
        printf("Nenhum Produto Cadastrado!");
    }
    
    do{
        encontrado = 0;
        
        printf("Digite o código do produto: ");
        scanf("%d", &valor);
        
        for(int i = 0;  i < qtdprodutos; i++)
        {
            if(produto[i].codigo == valor)
            {
                encontrado = 1;
                printf("\n|Produto Encontrado|\n");
                printf("Código: %d\n", produto[i].codigo);
                printf("Nome: %s\n", produto[i].nome);
                printf("Marca: %s\n", produto[i].modelo.marca);
                printf("Modelo: %s\n", produto[i].modelo.modelo);
                printf("Valor: %.2lf\n", produto[i].valor);
                carrinho.produto[qtdcarrinho] = produto[i];
                printf("Qual a quantidade desse produto você deseja: ");
                scanf("%d", &carrinho.quantidade[i]);
                qtdcarrinho++;
                break;
            }
        }
        
        if(!encontrado)
        {
            printf("Produto não encontrado!");
        }
        if(qtdcarrinho < TAM_CARRINHO)
        {
            printf("\nDeseja solicitar outro produto (1 = Sim / 0 = Não): ");
            scanf("%d", &continuar);
        }else{
            printf("Limite de produtos atingidos!\n");
            continuar = 0;
        }
        
    }while(continuar == 1 && qtdcarrinho < TAM_CARRINHO);
    
    return carrinho;
}
struct carrinhos calculasubtotal(struct carrinhos carrinho)
{
    carrinho.subtotal = 0;
    
    for (int i = 0; i < 3; i++)
    {
        if(carrinho.produto[i].codigo != 0)
        carrinho.subtotal = carrinho.subtotal + (carrinho.produto[i].valor*carrinho.quantidade[i]);
    }
    
    return carrinho;
}
struct carrinhos calculatotal(struct carrinhos carrinho)
{
    carrinho.desconto = 0;
    char validar;
    
    printf("Algum desconto será aplicado na compra(S OU N)?");
    scanf(" %c", &validar);
    
    if(validar == 'S' || validar == 's')
    {
        printf("Qual o desconto a ser aplicado(em %): ");
        scanf("%lf", &carrinho.desconto);
        
        carrinho.total = carrinho.subtotal * (1 - carrinho.desconto / 100);
        
    }else{
        carrinho.total = carrinho.subtotal;
    }
    
    return carrinho;
}
