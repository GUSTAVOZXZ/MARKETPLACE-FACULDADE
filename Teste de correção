#include <stdio.h>

/*Estruturas*/

struct telefones
{
    char fixo[15];
    char movel[16];
};

struct clientes
{
    int codigo;
    char nome[50];
    double cpf;
    char sexo;
    struct telefones tel;
};

struct modelos
{
    char marca[20];
    char modelo[20];
};

struct produtos 
{
    int codigo;
    char nome[20];
    double valor;
    struct modelos modelo;
};

struct carrinhos
{
    int quantidade [3];
    double subtotal;
    double desconto;
    double total;
    struct clientes cliente;
    struct produtos produto[3];
    
};

/*Funções declaradas acima da MAIN*/

int codigocliente(double cpf);
int cadastrarclientes(struct clientes cliente[], int qtdclientes, int TAM_CLI);
void listarclientes(struct clientes cliente[], int qtdclientes);
int produtoscodigo(struct modelos modelo);
int cadastrarproduto(struct produtos produto[], int qtdprodutos, int TAM_PROD);
void listarprodutos(struct produtos produto[], int qtdprodutos);
int localizacliente(struct clientes cliente[], int qtdclientes);
struct carrinhos localizaproduto(struct produtos produto[], int qtdprodutos, struct carrinhos carrinho, int TAM_CARRINHO);
struct carrinhos calculasubtotal(struct carrinhos carrinho);
struct carrinhos calculatotal(struct carrinhos carrinho);
void listarcarrinho(struct carrinhos carrinho);
struct carrinhos efetuarvenda(struct clientes cliente[], int qtdclientes, struct produtos produto[], int qtdprodutos, struct carrinhos carrinho, int TAM_CARRINHO);
struct carrinhos finalizarvenda(struct carrinhos carrinho);

int main()
{
    struct clientes cliente[3];
    struct produtos produto[10];
    struct carrinhos carrinho = {0};
    
    int TAM_CARRINHO = 3, TAM_CLI = 3, TAM_PROD = 10;
    int opcao, qtdclientes = 0, qtdprodutos = 0;
   
   /*Menu de opções visual*/
   
   do
   {
       printf("Seja bem vindo! Escolha sua opção!");
       printf("\n===============================\n");
       printf("1 - Cadastrar Clientes\n");
       printf("2 - Cadastrar Produtos\n");
       printf("3 - Listar Clientes\n");
       printf("4 - Listar Produtos\n");
       printf("5 - Visualizar Carrinho / Efetuar Venda\n");
       printf("0 - Sair\n");
       printf("Digite sua opção: ");
       scanf("%d", &opcao);
     
     /*Funções de cada valor escolhido pelo cliente*/
       
       switch(opcao)
       {
           case 1:
            qtdclientes = cadastrarclientes(cliente, qtdclientes,TAM_CLI);
            break;
           case 2:
            qtdprodutos = cadastrarproduto(produto, qtdprodutos, TAM_PROD);
            break;
           case 3: 
            listarclientes(cliente, qtdclientes);
            break;
           case 4:
            listarprodutos(produto, qtdprodutos);
            break;
           case 5:
           carrinho = efetuarvenda(cliente, qtdclientes, produto, qtdprodutos, carrinho, TAM_CARRINHO);
            break;
           case 0:
            printf("\nObrigado, encerrando solicitação!\n");
            break;
           default:
            printf("\nOpção Inválida!\n");
       }
   } while(opcao != 0);
   
   return 0;
}

/*Calculo para código do cliente pelo seu CPF*/

int codigocliente(double cpf) 
{
    int codigo = (int)(cpf / 100000);
    return codigo;
}

/*Função para cadastro dos clientes*/

int cadastrarclientes(struct clientes cliente[], int qtdclientes, int TAM_CLI)
{
    int continuar;
    
    if(qtdclientes >= TAM_CLI)
    {
        printf("\nLimite de cadastro atingido!\n");
        return qtdclientes;
    }
    
    do
    {
        printf("||Cadstro de clientes||\n");
        printf("Nome: ");
        scanf(" %49[^\n]", cliente[qtdclientes].nome);
        printf("Sexo: ");
        scanf(" %c", &cliente[qtdclientes].sexo);
        printf("CPF: ");
        scanf("%lf", &cliente[qtdclientes].cpf);
        cliente[qtdclientes].codigo = codigocliente(cliente[qtdclientes].cpf);
        printf("Telefone fixo: ");
        scanf(" %14[^\n]", cliente[qtdclientes].tel.fixo);
        printf("Telefone Móvel: ");
        scanf(" %15[^\n]", cliente[qtdclientes].tel.movel);
        
        qtdclientes++;
        
            if(qtdclientes < TAM_CLI)
            {
                printf("\nDeseja cadastrar outro cliente (1 = Sim / 0 = Não): ");
                scanf("%d", &continuar);
            } else{
                    printf("\nLimite de cadastro atingido!\n");
                }
    }while(qtdclientes < TAM_CLI && continuar == 1);
    
    return qtdclientes;
}

/*Calculo para codigo do produto pela marca e modelo*/

int produtoscodigo(struct modelos modelo)
{
    char c1 = modelo.marca[0];
    char c2 = modelo.marca[1];
    char c3 = modelo.modelo[0];
    char c4 = modelo.modelo[1];

    int v1 = c1;
    int v2 = c2;
    int v3 = c3;
    int v4 = c4;

    int hash = v1 * (31*31*31) + v2 * (31*31) + v3 * 31 + v4;
    
    return hash; /**Retorno para o cálculo HASH*/
}

/*Função desenvolvida para cadastro de produtos*/

int cadastrarproduto(struct produtos produto[], int qtdprodutos, int TAM_PROD)
{
    int continuar;
    
    if(qtdprodutos >= TAM_PROD)
    {
        printf("\nLimite de cadastro atingido!\n");
        
        return qtdprodutos; /*Retorno ao final do cadastro após limite atingido*/
    }
    
    do
    {
        printf("||Cadastro Produtos||\n");
        printf("Nome do produto: ");
        scanf(" %19[^\n]", produto[qtdprodutos].nome);
        printf("Marca do produto: ");
        scanf(" %19[^\n]", produto[qtdprodutos].modelo.marca);
        printf("Modelo do produto: ");
        scanf(" %19[^\n]", produto[qtdprodutos].modelo.modelo);
        produto[qtdprodutos].codigo = produtoscodigo(produto[qtdprodutos].modelo);
        printf("Valor: ");
        scanf("%lf", &produto[qtdprodutos].valor);
        
        qtdprodutos++; /*Variável declarada salvar o cadastro a cada passagem da repetição*/
        
        if(qtdprodutos < TAM_PROD)
            {
                printf("\nDeseja cadastrar outro produto (1 = Sim / 0 = Não): ");
                scanf("%d", &continuar);
            } else{
                    printf("\nLimite de cadastro atingido!\n");
                }
    }while(qtdprodutos < TAM_PROD && continuar == 1);
    
    return qtdprodutos; /*Laço de retorno ao final do código para retornar o valor salvo*/
}

