int localizacliente(struct clientes cliente[], int qtdclientes)
{
    int valor = 0;
    
    printf("Digite o código do cliente: ");
    scanf("%d", &valor);
    
    for(int i = 0; i < qtdclientes; i++)
    {
        if(cliente[i].codigo == valor)
        {
            printf("\n|Cliente Encontrado|\n");
            printf("Código: %d\n", cliente[i].codigo);
            printf("Nome: %s\n", cliente[i].nome);
            printf("CPF: %.0lf\n", cliente[i].cpf);
            printf("Sexo: %c\n", cliente[i].sexo);
            printf("Telefone Fixo: %s\n", cliente[i].tel.fixo);
            printf("Telefone movel: %s\n\n", cliente[i].tel.movel);
            
            return i;
        }
    }
    
    printf("Cliente não encontrado!\n");
    return -1;
}

// FUNÇÃO ALTERADA: Agora retorna a struct carrinhos completa.
struct carrinhos localizaproduto(struct produtos produto[], int qtdprodutos, struct carrinhos carrinho, int TAM_CARRINHO)
{
    int valor = 0, continuar;
    int encontrado;
    int qtdcarrinho = 0; // Usado para rastrear quantos itens ja estao na struct

    // Conta quantos itens já existem na struct carrinho
    while(qtdcarrinho < TAM_CARRINHO && carrinho.produto[qtdcarrinho].codigo != 0) {
        qtdcarrinho++;
    }
    
    if(qtdprodutos == 0)
    {
        printf("Nenhum Produto Cadastrado!");
        return carrinho;
    }
    
    do{
        encontrado = 0;
        
        printf("Digite o código do produto: ");
        scanf("%d", &valor);
        
        for(int i = 0; i < qtdprodutos; i++)
        {
            if(produto[i].codigo == valor)
            {
                encontrado = 1;
                printf("\n|Produto Encontrado|\n");
                printf("Código: %d\n", produto[i].codigo);
                printf("Nome: %s\n", produto[i].nome);
                printf("Valor: R$ %.2lf\n", produto[i].valor);
                
                // CÓPIA AGORA É MANTIDA: Salvamos na cópia local
                carrinho.produto[qtdcarrinho] = produto[i];
                carrinho.quantidade[qtdcarrinho] = 1;
                qtdcarrinho++;
                break; 
            }
        }
        
        if(!encontrado)
        {
            printf("Produto não encontrado!");
        }
        if(qtdcarrinho < TAM_CARRINHO)
        {
            printf("\nDeseja solicitar outro produto (1 = Sim / 0 = Não): ");
            scanf("%d", &continuar);
        }else{
            printf("Limite de produtos atingidos!\n");
            continuar = 0;
        }
        
    }while(continuar == 1 && qtdcarrinho < TAM_CARRINHO);
    
    // Retorna a struct completa com os produtos
    return carrinho;
}

// FUNÇÃO ALTERADA: Agora retorna a struct carrinhos completa.
struct carrinhos calculasubtotal(struct carrinhos carrinho)
{
    carrinho.subtotal = 0; 
    int qtdcarrinho = 0;

    // Determina a quantidade de itens no carrinho
    while(qtdcarrinho < 3 && carrinho.produto[qtdcarrinho].codigo != 0) {
        carrinho.subtotal = carrinho.subtotal + carrinho.produto[qtdcarrinho].valor;
        qtdcarrinho++;
    }
    
    return carrinho;
}

// FUNÇÃO ALTERADA: Agora retorna a struct carrinhos completa.
struct carrinhos calculatotal(struct carrinhos carrinho)
{
    carrinho.total = carrinho.subtotal;
    carrinho.desconto = 0; // Zera o desconto antes de perguntar
    char validar;
    
    printf("\nAlgum desconto será aplicado na compra (S OU N)? ");
    scanf(" %c", &validar);
    
    if(validar == 'S' || validar == 's')
    {
        printf("Qual o desconto a ser aplicado (em %%): ");
        scanf("%lf", &carrinho.desconto);
        
        carrinho.total = carrinho.subtotal * (1 - carrinho.desconto / 100.0);
    }
    
    return carrinho;
}

// FUNÇÃO ALTERADA: Não precisa mais receber qtdcarrinho, pode contar os itens.
void listarcarrinho(struct carrinhos carrinho)
{
    printf("\n===================================");
    printf("\n|| Resumo do Carrinho / Venda ||\n");
    printf("===================================\n");
    
    // Cliente
    printf("||Cliente||\n");
    printf("Nome: %s\n", carrinho.cliente.nome);
    printf("Sexo: %c\n", carrinho.cliente.sexo);
    printf("CPF: %.0lf\n", carrinho.cliente.cpf);
    printf("Telefone fixo: %s\n", carrinho.cliente.tel.fixo);
    printf("Telefone Móvel: %s\n", carrinho.cliente.tel.movel);
    printf("-----------------------------------\n");

    // Produtos - AGORA CORRETO
    printf("||Produtos Adicionados||\n");
    int qtdcarrinho = 0;
    
    // Lista os produtos até o código ser 0 (inicializado) ou atingir o limite
    while(qtdcarrinho < 3 && carrinho.produto[qtdcarrinho].codigo != 0)
    {
        printf("  Item %d: %s (%s - %.2lf) R$ %.2lf\n", 
               qtdcarrinho + 1, 
               carrinho.produto[qtdcarrinho].nome, 
               carrinho.produto[qtdcarrinho].modelo.marca,
               carrinho.produto[qtdcarrinho].valor,
               carrinho.produto[qtdcarrinho].valor);
        qtdcarrinho++;
    }
    
    if (qtdcarrinho == 0) {
        printf("  Nenhum produto adicionado ao carrinho.\n");
    }
    printf("-----------------------------------\n");

    // Totais
    printf("Subtotal da compra: R$ %.2lf\n", carrinho.subtotal);
    printf("Desconto: %.0lf%%\n", carrinho.desconto);
    printf("Valor Total: R$ %.2lf\n", carrinho.total);
    printf("===================================\n");
}

// FUNÇÃO ALTERADA: Não precisa mais receber qtdcarrinho, ela é implícita na struct.
void efetuarvenda(struct clientes cliente[], int qtdclientes, struct produtos produto[], int qtdprodutos, struct carrinhos carrinho, int TAM_CARRINHO)
{
    // 1. Listar Clientes e Localizar
    listarclientes(cliente, qtdclientes);
    int idxcliente = localizacliente(cliente, qtdclientes);
    
    if (idxcliente == -1) {
        printf("Venda cancelada: Cliente não encontrado.\n");
        return;
    }
    
    // Cópia da struct cliente para o carrinho local.
    carrinho.cliente = cliente[idxcliente];
    
    // 2. Listar Produtos e Adicionar ao Carrinho
    listarprodutos(produto, qtdprodutos);
    
    // ATRIBUIÇÃO CHAVE: A cópia do carrinho é enviada e o carrinho atualizado é retornado.
    carrinho = localizaproduto(produto, qtdprodutos, carrinho, TAM_CARRINHO);
    
    if (carrinho.produto[0].codigo == 0) {
        printf("Nenhum produto adicionado. Venda cancelada.\n");
        return;
    }

    // 3. Cálculos
    // ATRIBUIÇÃO CHAVE: Calcula o subtotal e o retorna na struct.
    carrinho = calculasubtotal(carrinho);
    
    // ATRIBUIÇÃO CHAVE: Calcula o total (com desconto) e o retorna na struct.
    carrinho = calculatotal(carrinho);
    
    // 4. Listar Carrinho
    listarcarrinho(carrinho);
    
    printf("\n✅ Venda concluída. Lista de produtos e valores corrigidos pelo retorno da struct.\n");
}
