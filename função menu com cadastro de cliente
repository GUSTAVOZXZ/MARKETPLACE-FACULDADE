#include <stdio.h>
struct telefones{
    char fixo[15];
    char movel[16];
};
struct clientes{
    int codigo;
    double cpf;
    char nome[50];
    char sexo;
    struct telefones tel;
}; struct clientes c[3];
int geraCodigoCliente(double cpf) {
    int codigo = (int)(cpf / 100000);
    return codigo;
};
void cadastrarCliente(int i){
    printf("||Cadstro de clientes||\n");
    printf("Nome: ");
    scanf("%s", &c[i].nome);
    printf("Sexo: ");
    scanf(" %c", &c[i].sexo);
    printf("CPF: ");
    scanf("%lf", &c[i].cpf);
    c[i].codigo = geraCodigoCliente(c[i].cpf);
    printf("Telefone fixo: ");
    scanf("%s", &c[i].tel.fixo);
    printf("Telefone Móvel: ");
    scanf("%s", &c[i].tel.movel);
    };
void mostrarMenuInicial(int opcao, int i){
    printf("\t||Bem-vindo ao menu!||\n1 - Cadastar clientes\n2 - Cadastrar produtos\n3 - Listar clientes\n4 - Listar produtos\n5 - Efetuar venda\n");
    scanf("%d", &opcao);
    switch(opcao){
        case 1: cadastrarCliente(i);
        break;
        case 2: //função cad de produtos
        break;
        case 3: //função listar cliente
        break;
        case 4: //função listas produtos
        break;
        case 5: // efetuar vendas
        break;
        default: printf("Obrigrado por Usar!");
    }
};

int main() {
    int opcao, i=0;
    mostrarMenuInicial(opcao, i);

    return 0;
}
